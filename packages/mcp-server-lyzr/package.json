{
  "name": "mcp-server-lyzr",
  "version": "0.1.0",
  "description": "MCP server wrapping the Lyzr Enterprise Agent API (bring-your-own-key).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lyzr-mcp": "build/index.js",
    "lyzr-mcp-skills": "build/cli/install-skills.js"
  },
  "files": ["build", "skills"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mcp-utils": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
