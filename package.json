{
  "name": "lyzr-mcp",
  "version": "0.1.0",
  "description": "MCP server wrapping the Lyzr Enterprise Agent API (bring-your-own-key).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lyzr-mcp": "build/index.js",
    "lyzr-mcp-skills": "build/cli/install-skills.js"
  },
  "files": ["build", "skills"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "generate:openapi-types": "node scripts/generate-openapi-types.mjs",
    "registry:update": "node scripts/registry/update-version.mjs && biome format --write server.json",
    "registry:publish": "npx --yes @modelcontextprotocol/mcp-publisher publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
