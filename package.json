{
  "name": "lyzr-mcp-monorepo",
  "version": "0.1.0",
  "description": "MCP server wrapping the Lyzr Enterprise Agent API (bring-your-own-key). npm workspaces monorepo.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/mcp-utils", "packages/mcp-server-lyzr"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=mcp-server-lyzr",
    "start": "npm run start --workspace=mcp-server-lyzr",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=mcp-server-lyzr",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "generate:openapi-types": "node scripts/generate-openapi-types.mjs",
    "registry:update": "node scripts/registry/update-version.mjs && biome format --write server.json",
    "registry:publish": "npx --yes @modelcontextprotocol/mcp-publisher publish"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
